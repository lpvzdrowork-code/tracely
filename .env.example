TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Used to sign dashboard session cookies (lib/session.js). Required --
# login/signup will throw a 500 without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret

# Used to authenticate cron-triggered requests to /api/cleanup (see vercel.json).
# Generate the same way as SESSION_SECRET.
#
# NOTE: On Vercel Pro/Enterprise, Vercel automatically sends this as
# `Authorization: Bearer <CRON_SECRET>` on cron invocations once it's set in
# your project's environment variables. On the Hobby plan, Vercel does NOT
# automatically inject this header — you must configure it yourself or the
# cleanup endpoint will reject every cron call with a 401. See:
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=change-this-to-a-long-random-secret

# Optional. Fallback retention (in days) for any workspace that hasn't set
# its own value yet from the dashboard's Settings panel. Once a workspace
# sets one, its own value takes priority and this var is ignored for it.
LOG_RETENTION_DAYS=30

# Optional. Minutes a rotated-out API key keeps working after rotation
# (see Settings > Workspaces > Rotate key), so a live Roblox game has time
# to pick up the new key before the old one stops accepting requests.
# Set to 0 to disable the grace period (old key dies immediately).
ROTATION_GRACE_MINUTES=60

# The single email address that gets access to the /api/admin/* endpoints.
# lib/admin-auth.js compares every authenticated request's session email against
# this value. Rotate without a redeploy by updating it in Vercel's env var UI.
ADMIN_EMAIL=you@example.com