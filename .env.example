TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Used to sign dashboard session cookies (lib/session.js). Required --
# login/signup will throw a 500 without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret

# Vercel sends this as a Bearer token on cron-triggered requests to
# /api/cleanup (see vercel.json). Generate the same way as SESSION_SECRET.
CRON_SECRET=change-this-to-a-long-random-secret

# Optional. Fallback retention (in days) for any workspace that hasn't set
# its own value yet from the dashboard's Settings panel. Once a workspace
# sets one, its own value takes priority and this var is ignored for it.
LOG_RETENTION_DAYS=30

# Optional. Minutes a rotated-out API key keeps working after rotation
# (see Settings > Workspaces > Rotate key), so a live Roblox game has time
# to pick up the new key before the old one stops accepting requests.
# Set to 0 to disable the grace period (old key dies immediately).
ROTATION_GRACE_MINUTES=60

#The ADMIN_EMAIL env var is the single value lib/admin-auth.js checks on every request to any /api/admin/* endpoint
ADMIN_EMAIL=you@example.com