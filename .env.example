TRACELY_KEY=change-this-to-a-long-random-secret
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
CRON_SECRET=change-this-to-a-long-random-secret

# Optional. Used only as the initial default before anyone sets retention
# from the dashboard's Settings panel — once that's set, the value stored
# in the `settings` table takes priority and this var is ignored.
LOG_RETENTION_DAYS=retention-days-for-logs-in-days